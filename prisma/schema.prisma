generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model accounts {
  id                String  @id
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  users             users   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model attachments {
  id           String   @id
  filename     String
  originalName String
  mimeType     String
  size         Int
  path         String
  ticketId     String
  uploadedBy   String
  createdAt    DateTime @default(now())
  tickets      tickets  @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  users        users    @relation(fields: [uploadedBy], references: [id])

  @@index([ticketId, createdAt(sort: Desc)])
  @@index([uploadedBy, createdAt(sort: Desc)])
}

model audit_logs {
  id         String   @id
  action     String
  entityType String
  entityId   String
  userId     String?
  userEmail  String?
  ipAddress  String?
  userAgent  String?
  details    Json?
  createdAt  DateTime @default(now())
  users      users?   @relation(fields: [userId], references: [id])

  @@index([entityType, entityId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
}

model backups {
  id         String   @id
  filename   String
  filepath   String
  size       Int
  type       String
  status     String
  error      String?
  checksum   String?
  compressed Boolean  @default(false)
  encrypted  Boolean  @default(false)
  /// Motor: pgbackrest | export | import
  engine     String   @default("pgbackrest")
  /// Tipo: full | diff | incr | export
  backupKind String   @default("full")
  /// Etiqueta pgBackRest (ej. 20260708-120000F)
  label      String?
  /// @deprecated — solo respaldos legacy; usar export + restore selectivo
  module     String?
  /// JSON con metadata del backup (conteo de tablas, pgBackRest info, etc.)
  metadata   String?
  createdAt  DateTime @default(now())

  @@index([status, createdAt(sort: Desc)])
  @@index([type, status])
  @@index([engine, backupKind, createdAt(sort: Desc)])
  @@index([label])
}

model categories {
  id                     String                   @id
  name                   String
  description            String?
  level                  Int
  parentId               String?
  departmentId           String?
  familyId               String?                  @map("family_id")
  order                  Int                      @default(0)
  color                  String?                  @default("#6B7280")
  isActive               Boolean                  @default(true)
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime
  departments            departments?             @relation(fields: [departmentId], references: [id])
  family                 families?                @relation(fields: [familyId], references: [id])
  categories             categories?              @relation("categoriesTocategories", fields: [parentId], references: [id])
  other_categories       categories[]             @relation("categoriesTocategories")
  knowledge_articles     knowledge_articles[]
  sla_policies           sla_policies[]           @relation("SLAPolicyCategory")
  technician_assignments technician_assignments[]
  tickets                tickets[]
  patrolFamilyConfigs    patrol_family_config[]   @relation("PatrolIncidentCategory")

  @@index([departmentId])
  @@index([familyId])
  @@index([parentId, level, isActive])
  @@index([name, level])
}

model comments {
  id         String   @id
  content    String
  isInternal Boolean  @default(false)
  ticketId   String
  authorId   String
  createdAt  DateTime @default(now())
  updatedAt  DateTime
  users      users    @relation(fields: [authorId], references: [id])
  tickets    tickets  @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
}

model departments {
  id               String              @id
  name             String              @unique
  description      String?
  color            String?             @default("#3B82F6")
  isActive         Boolean             @default(true)
  order            Int                 @default(0)
  familyId         String?             @map("family_id")
  createdAt        DateTime            @default(now())
  updatedAt        DateTime
  categories       categories[]
  equipment        equipment[]
  equipmentBatches equipment_batches[] // Nueva relación con lotes
  family           families?           @relation(fields: [familyId], references: [id])
  licenses         software_licenses[]
  users            users[]
  news_departments news_departments[]
  form_departments form_departments[]

  @@index([isActive, order])
  @@index([familyId])
}

model notification_preferences {
  userId         String  @id
  emailEnabled   Boolean @default(true)
  teamsEnabled   Boolean @default(false)
  inAppEnabled   Boolean @default(true)
  ticketCreated  Boolean @default(true)
  ticketUpdated  Boolean @default(true)
  ticketAssigned Boolean @default(true)
  ticketResolved Boolean @default(true)
  commentAdded   Boolean @default(true)
  users          users   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model notifications {
  id           String           @id
  title        String
  message      String
  type         NotificationType @default(INFO)
  userId       String
  ticketId     String?
  isRead       Boolean          @default(false)
  /// Oculta la notificación del inbox hasta esta fecha (snooze individual)
  snoozedUntil DateTime?
  metadata     Json?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  tickets      tickets?         @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  users        users            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([userId, isRead, createdAt(sort: Desc)])
  @@index([userId, snoozedUntil])
}

/// Silenciar / snooze por entidad (ticket, equipo, ronda, acta…).
/// mutedUntil = null → silenciado indefinido; fecha futura → snooze temporal.
model notification_mutes {
  id         String    @id
  userId     String
  /// Clave estable: ticket:{id} | equipment:{id} | patrol:{id} | act:{id} | maintenance:{id}
  entityKey  String
  mutedUntil DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  users      users     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, entityKey])
  @@index([userId, mutedUntil])
}

model oauth_accounts {
  id           String    @id
  provider     String
  providerId   String
  accessToken  String
  refreshToken String?
  expiresAt    DateTime?
  userId       String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime
  users        users     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
}

model oauth_configs {
  id           String   @id
  provider     String   @unique
  clientId     String
  clientSecret String
  tenantId     String?
  isEnabled    Boolean  @default(false)
  redirectUri  String?
  scopes       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime
}

model pages {
  id             String   @id
  slug           String   @unique
  title          String
  content        String
  isPublished    Boolean  @default(false)
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime

  @@index([isPublished, createdAt(sort: Desc)])
}

model sessions {
  id           String   @id
  sessionToken String   @unique
  userId       String
  expires      DateTime
  users        users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expires])
}

model site_config {
  id          String   @id
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime
}

model system_settings {
  id          String   @id
  key         String   @unique
  value       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime
}

model technician_assignments {
  id           String     @id
  technicianId String
  categoryId   String
  priority     Int        @default(1)
  maxTickets   Int?
  autoAssign   Boolean    @default(true)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime
  categories   categories @relation(fields: [categoryId], references: [id])
  users        users      @relation(fields: [technicianId], references: [id])

  @@unique([technicianId, categoryId])
  @@index([categoryId, isActive, autoAssign])
  @@index([technicianId, isActive])
}

model ticket_history {
  id        String   @id
  action    String
  field     String?
  oldValue  String?
  newValue  String?
  comment   String?
  ticketId  String
  userId    String
  createdAt DateTime @default(now())
  tickets   tickets  @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  users     users    @relation(fields: [userId], references: [id])

  @@index([ticketId, createdAt(sort: Desc)])
}

model ticket_ratings {
  id                                       String   @id
  ticketId                                 String   @unique
  clientId                                 String
  technicianId                             String?
  rating                                   Int
  feedback                                 String?
  responseTime                             Int
  technicalSkill                           Int
  communication                            Int
  problemResolution                        Int
  isPublic                                 Boolean  @default(true)
  createdAt                                DateTime @default(now())
  updatedAt                                DateTime
  users_ticket_ratings_clientIdTousers     users    @relation("ticket_ratings_clientIdTousers", fields: [clientId], references: [id])
  users_ticket_ratings_technicianIdTousers users?   @relation("ticket_ratings_technicianIdTousers", fields: [technicianId], references: [id])
  tickets                                  tickets  @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([rating, createdAt(sort: Desc)])
  @@index([technicianId, createdAt(sort: Desc)])
}

model tickets {
  id                               String                      @id
  title                            String
  description                      String
  location                         String?
  status                           TicketStatus                @default(OPEN)
  priority                         TicketPriority              @default(MEDIUM)
  clientId                         String
  assigneeId                       String?
  categoryId                       String
  createdById                      String?
  resolvedAt                       DateTime?
  closedAt                         DateTime?
  firstResponseAt                  DateTime?
  slaDeadline                      DateTime?
  estimatedTime                    Int?
  actualTime                       Int?
  tags                             String[]
  source                           TicketSource                @default(WEB)
  ticketCode                       String?                     @unique @map("ticket_code") @db.VarChar(30)
  familyId                         String?                     @map("family_id")
  codeIsManual                     Boolean                     @default(false) @map("code_is_manual")
  createdAt                        DateTime                    @default(now())
  updatedAt                        DateTime
  attachments                      attachments[]
  comments                         comments[]
  knowledge_article                knowledge_articles?         @relation("knowledge_articles_source")
  maintenance_records              maintenance_records[]
  notifications                    notifications[]
  resolution_plans                 resolution_plans[]
  sla_violations                   sla_violations[]
  ticket_collaborators             ticket_collaborators[]
  ticket_history                   ticket_history[]
  ticket_knowledge_articles        ticket_knowledge_articles[]
  ticket_ratings                   ticket_ratings?
  ticket_sla_metrics               ticket_sla_metrics?
  users_tickets_assigneeIdTousers  users?                      @relation("tickets_assigneeIdTousers", fields: [assigneeId], references: [id])
  categories                       categories                  @relation(fields: [categoryId], references: [id])
  users_tickets_clientIdTousers    users                       @relation("tickets_clientIdTousers", fields: [clientId], references: [id])
  users_tickets_createdByIdTousers users?                      @relation("tickets_createdByIdTousers", fields: [createdById], references: [id])
  family                           families?                   @relation(fields: [familyId], references: [id])
  checkInId                        String?                     @map("check_in_id")
  checkIn                          patrol_check_ins?           @relation(fields: [checkInId], references: [id])
  patrol_incidents                 patrol_incidents[]

  @@index([assigneeId, status])
  @@index([categoryId, status])
  @@index([clientId, createdAt(sort: Desc)])
  @@index([createdById])
  @@index([source, status])
  @@index([status, priority])
  @@index([title, description])
  @@index([familyId, status])
  @@index([ticketCode])
  // Índices adicionales para consultas frecuentes
  @@index([status, createdAt(sort: Desc)])
  @@index([clientId, status])
  @@index([priority])
  @@index([updatedAt(sort: Desc)])
}

model user_settings {
  id                   String   @id
  userId               String   @unique
  emailNotifications   Boolean  @default(true)
  pushNotifications    Boolean  @default(true)
  ticketUpdates        Boolean  @default(true)
  systemAlerts         Boolean  @default(true)
  weeklyReport         Boolean  @default(false)
  soundEnabled         Boolean  @default(true)
  ticketCreated        Boolean  @default(true)
  ticketAssigned       Boolean  @default(true)
  statusChanged        Boolean  @default(true)
  newComments          Boolean  @default(true)
  ticketUpdated        Boolean  @default(true)
  /// Master switch: notificaciones del módulo Tickets
  notifyTickets        Boolean  @default(true)
  /// Master switch: notificaciones del módulo Inventario
  notifyInventory      Boolean  @default(true)
  /// Master switch: notificaciones del módulo Rondas
  notifyPatrols        Boolean  @default(true)
  /// Master switch: alertas por Telegram (requiere telegramChatId en users)
  telegramNotifications Boolean @default(true) @map("telegram_notifications")
  /// Último digest semanal enviado (idempotencia del cron)
  lastWeeklyDigestAt   DateTime?
  quietHoursEnabled    Boolean  @default(false)
  quietHoursStart      String   @default("22:00")
  quietHoursEnd        String   @default("08:00")
  autoAssignEnabled    Boolean  @default(true)
  maxConcurrentTickets Int      @default(10)
  theme                String   @default("light")
  language             String   @default("es")
  timezone             String   @default("America/Guayaquil")
  createdAt            DateTime @default(now())
  updatedAt            DateTime
  users                users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model email_queue {
  id           String    @id
  toEmail      String
  subject      String
  body         String
  templateName String?
  templateData String?
  status       String    @default("pending")
  attempts     Int       @default(0)
  maxAttempts  Int       @default(3)
  scheduledAt  DateTime  @default(now())
  sentAt       DateTime?
  errorMessage String?
  createdAt    DateTime  @default(now())

  @@index([status, scheduledAt])
  @@index([createdAt(sort: Desc)])
  @@index([toEmail])
}

model telegram_queue {
  id           String    @id
  userId       String?   @map("user_id")
  chatId       String    @map("chat_id")
  title        String
  body         String
  priority     String    @default("important")
  module       String?
  link         String?
  status       String    @default("pending")
  attempts     Int       @default(0)
  maxAttempts  Int       @default(3) @map("max_attempts")
  scheduledAt  DateTime  @default(now()) @map("scheduled_at")
  sentAt       DateTime? @map("sent_at")
  errorMessage String?   @map("error_message")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([status, scheduledAt])
  @@index([chatId])
  @@index([createdAt(sort: Desc)])
  @@map("telegram_queue")
}

/// Catálogo de módulos del sistema — define qué módulos existen y sus defaults por rol
model system_modules {
  key              String   @id // 'tickets' | 'inventory' | 'contracts' | ...
  name             String // 'Tickets de Soporte'
  description      String? // Descripción para el admin
  icon             String? // Nombre del icono lucide
  isActive         Boolean  @default(true) // El módulo está disponible en el sistema
  order            Int      @default(0) // Orden de aparición en la UI
  defaultForAdmin  Boolean  @default(true) // ADMINs lo tienen por defecto
  defaultForTech   Boolean  @default(false) // TECHNICIANs lo tienen por defecto
  defaultForClient Boolean  @default(false) // CLIENTs lo tienen por defecto
  requiresManager  Boolean  @default(false) // Requiere canManageInventory para gestión completa
  familyScoped     Boolean  @default(true) // Se activa/desactiva por familia también
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([isActive, order])
}

model users {
  id                                                String                          @id
  email                                             String                          @unique
  name                                              String
  passwordHash                                      String?
  role                                              UserRole                        @default(CLIENT)
  departmentId                                      String?
  phone                                             String?
  avatar                                            String?
  isActive                                          Boolean                         @default(true)
  isEmailVerified                                   Boolean                         @default(false)
  canManageInventory                                Boolean                         @default(false)
  ticketsEnabled                                    Boolean                         @default(true)
  inventoryEnabled                                  Boolean                         @default(false)
  patrolsEnabled                                    Boolean                         @default(false) @map("patrols_enabled")
  newsEnabled                                       Boolean                         @default(false) @map("news_enabled")
  canManageNews                                     Boolean                         @default(false) @map("can_manage_news")
  formsEnabled                                      Boolean                         @default(false) @map("forms_enabled")
  canManageForms                                    Boolean                         @default(false) @map("can_manage_forms")
  credentialsEnabled                                Boolean                         @default(false) @map("credentials_enabled")
  canManageCredentials                              Boolean                         @default(false) @map("can_manage_credentials")
  lastLogin                                         DateTime?
  passwordChangedAt                                 DateTime?                       @map("password_changed_at")
  oauthProvider                                     String?
  oauthId                                           String?
  createdAt                                         DateTime                        @default(now())
  updatedAt                                         DateTime
  isSuperAdmin                                      Boolean                         @default(false) @map("is_super_admin")
  canRequestAssets                                  Boolean                         @default(false) @map("can_request_assets")
  /// Acceso a Base de conocimientos (hijo del módulo Tickets). Default true = comportamiento histórico.
  canAccessKnowledge                                Boolean                         @default(true) @map("can_access_knowledge")
  /// ID de chat de Telegram vinculado (opcional). Necesario para recibir alertas del bot.
  telegramChatId                                    String?                         @unique @map("telegram_chat_id")
  accounts                                          accounts[]
  userFamilyAccess                                  user_family_access[]
  article_votes                                     article_votes[]
  attachments                                       attachments[]
  audit_logs                                        audit_logs[]
  comments                                          comments[]
  decommissionApprovals                             decommission_acts[]             @relation("DecommissionApprover")
  decommissionAttachments                           decommission_attachments[]
  decommissionRequests                              decommission_requests[]         @relation("DecommissionRequester")
  decommissionReviews                               decommission_requests[]         @relation("DecommissionReviewer")
  decommissionTechnicianReviews                     decommission_requests[]         @relation("DecommissionTechnician")
  decommissionManagerReviews                        decommission_requests[]         @relation("DecommissionManager")
  assignmentsDelivered                              equipment_assignments[]         @relation("AssignmentDeliverer")
  assignmentsReceived                               equipment_assignments[]         @relation("AssignmentReceiver")
  equipmentAttachments                              equipment_attachments[]
  knowledge_articles                                knowledge_articles[]            @relation("knowledge_articles_author")
  licenseAttachments                                license_attachments[]
  maintenanceRequests                               maintenance_records[]           @relation("MaintenanceRequester")
  maintenanceRecords                                maintenance_records[]           @relation("MaintenanceTechnician")
  notification_preferences                          notification_preferences?
  notification_mutes                                notification_mutes[]
  notifications                                     notifications[]
  oauth_accounts                                    oauth_accounts[]
  password_reset_tokens                             password_reset_tokens[]
  resolution_plans_created                          resolution_plans[]              @relation("ResolutionPlanCreator")
  tasks_assigned                                    resolution_tasks[]              @relation("TaskAssignee")
  sessions                                          sessions[]
  licensesAssigned                                  software_licenses[]             @relation("LicenseUser")
  stockMovementsAssigned                            stock_movements[]               @relation("StockMovementAssignedTo")
  stockMovements                                    stock_movements[]               @relation("StockMovementUser")
  technician_assignments                            technician_assignments[]
  ticketCollaborationsAdded                         ticket_collaborators[]          @relation("CollaboratorAddedBy")
  ticketCollaborations                              ticket_collaborators[]          @relation("TicketCollaborator")
  ticket_history                                    ticket_history[]
  articles_created                                  ticket_knowledge_articles[]     @relation("ArticleCreator")
  ticket_ratings_ticket_ratings_clientIdTousers     ticket_ratings[]                @relation("ticket_ratings_clientIdTousers")
  ticket_ratings_ticket_ratings_technicianIdTousers ticket_ratings[]                @relation("ticket_ratings_technicianIdTousers")
  tickets_tickets_assigneeIdTousers                 tickets[]                       @relation("tickets_assigneeIdTousers")
  tickets_tickets_clientIdTousers                   tickets[]                       @relation("tickets_clientIdTousers")
  tickets_tickets_createdByIdTousers                tickets[]                       @relation("tickets_createdByIdTousers")
  user_settings                                     user_settings?
  departments                                       departments?                    @relation(fields: [departmentId], references: [id])
  managedWarehouses                                 warehouses[]                    @relation("WarehouseManager")
  webhooks_created                                  webhooks[]                      @relation("WebhookCreator")
  contractsCreated                                  contracts[]                     @relation("ContractCreator")
  contractAmendmentsCreated                         contract_amendments[]         @relation("ContractAmendmentCreator")
  contractAttachmentsUploaded                       contract_attachments[]          @relation("ContractAttachmentUploader")
  contractPaymentsCreated                           contract_payments[]             @relation("PaymentCreator")
  saleRequests                                      equipment_sales[]               @relation("SaleRequester")
  saleApprovals                                     equipment_sales[]               @relation("SaleApprover")
  assetRequestsCreated                              asset_requests[]                @relation("AssetRequestRequester")
  assetRequestsReviewed                             asset_requests[]                @relation("AssetRequestReviewer")
  assetRequestsFulfilled                            asset_requests[]                @relation("AssetRequestFulfiller")
  batchesReceived                                   equipment_batches[]             @relation("BatchReceiver")
  patrolsAsAgent                                    patrols[]                       @relation("PatrolAgentExecution")
  patrolSchedulesAsAgent                            patrol_schedules[]              @relation("PatrolAgent")
  patrolCheckIns                                    patrol_check_ins[]              @relation("PatrolCheckInAgent")
  news_created                                      news[]                          @relation("NewsCreator")
  news_updated                                      news[]                          @relation("NewsUpdater")
  news_users                                        news_users[]
  news_views                                        news_views[]
  news_reactions                                    news_reactions[]
  news_comments                                     news_comments[]
  news_attachments_uploaded                         news_attachments[]              @relation("NewsAttachmentUploader")
  forms_created                                     forms[]                         @relation("FormCreator")
  forms_updated                                     forms[]                         @relation("FormUpdater")
  form_users                                        form_users[]
  form_downloads                                    form_downloads[]
  form_attachments_uploaded                         form_attachments[]              @relation("FormAttachmentUploader")
  incidentsAsAgent                                  patrol_incidents[]              @relation("IncidentAgent")
  incidentsAsResolver                               patrol_incidents[]              @relation("IncidentResolver")
  pushSubscriptions                                 push_subscriptions[]
  contractsAsCustodian                            contracts[]                     @relation("ContractCustodian")
  contractsAsBackupCustodian                        contracts[]                     @relation("ContractBackupCustodian")
  contractAssignmentsAsClient                       contract_assignments[]          @relation("ContractAssignmentClient")
  contractAssignmentsDelivered                      contract_assignments[]          @relation("ContractAssignmentDeliverer")
  inventorySavedReports                             inventory_saved_reports[]       @relation("InventorySavedReportOwner")
  inventoryScheduledReports                       inventory_scheduled_reports[]   @relation("InventoryScheduledReportOwner")
  credentialVaultsOwned                           credential_vaults[]             @relation("CredentialVaultOwner")
  credentialEntriesCreated                        credential_entries[]            @relation("CredentialEntryCreator")
  credentialEntriesUpdated                        credential_entries[]            @relation("CredentialEntryUpdater")
  credentialShares                                credential_shares[]
  telegramLinkTokens                              telegram_link_tokens[]

  @@index([departmentId])
  @@index([name, email])
  @@index([role, isActive])
}

model verification_tokens {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// Tokens de vinculación de cuenta Telegram (vida: 15 min; invalidados al usar)
model telegram_link_tokens {
  id        String    @id
  userId    String    @map("user_id")
  /// Código de 6 caracteres que el usuario escribe en el bot
  token     String    @unique
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      users     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
  @@index([token, expiresAt])
  @@map("telegram_link_tokens")
}

model password_reset_tokens {
  id        String   @id
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  users     users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token, expiresAt])
  @@index([userId, createdAt(sort: Desc)])
}

model knowledge_articles {
  id                        String                      @id @default(cuid())
  title                     String
  content                   String
  summary                   String?
  categoryId                String
  tags                      String[]
  sourceTicketId            String?                     @unique
  authorId                  String
  familyId                  String?                     @map("family_id")
  views                     Int                         @default(0)
  helpfulVotes              Int                         @default(0)
  notHelpfulVotes           Int                         @default(0)
  isPublished               Boolean                     @default(true)
