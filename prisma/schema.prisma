// ============================================
// EQUIPMENT_MODELS - Catálogo de Modelos
// ============================================
model equipment_models {
  id                 String            @id @default(uuid())
  brandId            String?           @map("brand_id")
  brand              equipment_brands? @relation(fields: [brandId], references: [id])
  model              String            @db.VarChar(200)
  sku                String?           @unique @db.VarChar(100)
  typeId             String            @map("type_id")
  type               equipment_types   @relation(fields: [typeId], references: [id])
  defaultAccessories String[]          @default([])
  standardPrice      Float?            @map("standard_price")
  modelPhotoUrl      String?           @map("model_photo_url")
  isActive           Boolean           @default(true) @map("is_active")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  instances equipment[]
  batches   equipment_batches[]
  contracts contracts[]         @relation("ContractModel")

  @@index([typeId, isActive])
  @@index([brandId])
  @@map("equipment_models")
}

// ============================================
// EQUIPMENT_BATCHES - Lotes de Compra
// ============================================
model equipment_batches {
  id                  String           @id @default(uuid())
  batchCode           String           @unique @db.VarChar(50)
  description         String?
  modelId             String           @map("model_id")
  model               equipment_models @relation(fields: [modelId], references: [id])
  quantity            Int
  supplierId          String?          @map("supplier_id")
  supplier            suppliers?       @relation(fields: [supplierId], references: [id])
  purchaseDate        DateTime         @map("purchase_date")
  unitPrice           Float            @map("unit_price")
  totalPrice          Float            @map("total_price")
  invoiceNumber       String?          @map("invoice_number") @db.VarChar(100)
  purchaseOrderNumber String?          @map("purchase_order_number") @db.VarChar(100)
  warehouseId         String?          @map("warehouse_id")
  warehouse           warehouses?      @relation(fields: [warehouseId], references: [id])
  status              String           @default("received") @db.VarChar(20)
  receivedBy          String           @map("received_by")
  receiver            users            @relation("BatchReceiver", fields: [receivedBy], references: [id])
  receivedAt          DateTime         @default(now()) @map("received_at")
  notes               String?

  // NUEVOS CAMPOS para formulario unificado
  customValues Json?        @map("custom_values") // Valores de atributos personalizados del tipo
  accessories  Json? // Accesorios comunes [{name: "Mouse", quantity: 1}, ...]
  condition    String?      @db.VarChar(20) // nuevo, bueno, regular, malo
  propertyType String?      @map("property_type") @db.VarChar(20) // activo_fijo, alquiler, prestamo
  departmentId String?      @map("department_id") // Departamento responsable del lote
  department   departments? @relation(fields: [departmentId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  contracts contracts[] @relation("ContractBatch")
  equipment equipment[]

  @@index([modelId, status])
  @@index([supplierId])
  @@index([warehouseId])
  @@index([purchaseDate])
  @@index([departmentId]) // Nuevo índice
  @@index([modelId, status, createdAt(sort: Desc)]) // Nuevo índice compuesto
  @@map("equipment_batches")
}

model equipment {
  id           String @id @default(uuid())
  code         String @unique
  serialNumber String @map("serial_number")

  // NUEVO: Referencia al modelo
  modelId String           @map("model_id")
  model   equipment_models @relation(fields: [modelId], references: [id])

  // NUEVO: Referencia al lote (opcional)
  batchId String?            @map("batch_id")
  batch   equipment_batches? @relation(fields: [batchId], references: [id])

  // DEPRECATED: Mantener por compatibilidad (3 meses)
  brand           String
  modelDeprecated String @map("model")

  typeId                String                    @map("type_id")
  departmentId          String?                   @map("department_id")
  status                EquipmentStatus           @default(AVAILABLE)
  condition             EquipmentCondition        @default(USED)
  ownershipType         OwnershipType             @default(FIXED_ASSET) @map("ownership_type")
  purchaseDate          DateTime?                 @map("purchase_date")
  purchasePrice         Float?                    @map("purchase_price")
  warrantyExpiration    DateTime?                 @map("warranty_expiration")
  accessories           String[]
  location              String?
  physicalLocation      String?                   @map("physical_location")
  notes                 String?
  photoUrl              String?                   @map("photo_url")
  qrCode                String                    @unique @map("qr_code")
  rentalProvider        String?                   @map("rental_provider")
  rentalContractNumber  String?                   @map("rental_contract_number")
  rentalStartDate       DateTime?                 @map("rental_start_date")
  rentalEndDate         DateTime?                 @map("rental_end_date")
  rentalMonthlyCost     Float?                    @map("rental_monthly_cost")
  rentalContactName     String?                   @map("rental_contact_name")
  rentalContactEmail    String?                   @map("rental_contact_email")
  rentalContactPhone    String?                   @map("rental_contact_phone")
  rentalNotes           String?                   @map("rental_notes")
  rentalAlertSentAt     DateTime?                 @map("rental_alert_sent_at")
  /// Fecha física de entrega del equipo en arriendo (distinta del inicio del contrato)
  rentalDeliveryDate    DateTime?                 @map("rental_delivery_date")
  /// Valor de opción de compra / buyout mientras sigue en renta
  rentalBuyoutValue     Float?                    @map("rental_buyout_value")
  /// Decisión del cliente respecto al fin de renta
  rentalClientResponse  RentalClientResponse      @default(NOT_NOTIFIED) @map("rental_client_response")
  supplierId            String?                   @map("supplier_id")
  invoiceNumber         String?                   @map("invoice_number") @db.VarChar(100)
  purchaseOrderNumber   String?                   @map("purchase_order_number") @db.VarChar(100)
  usefulLifeYears       Float?                    @map("useful_life_years")
  residualValue         Float?                    @default(0) @map("residual_value")
  warehouseId           String?                   @map("warehouse_id")
  acquisitionMode       OwnershipType?            @map("acquisition_mode")
  depreciationRate      Float?                    @map("depreciation_rate")
  depreciationMethod    DepreciationMethod?       @map("depreciation_method")
  totalUnits            Float?                    @map("total_units")
  usedUnits             Float?                    @map("used_units")
  saleListingPrice      Float?                    @map("sale_listing_price")
  estimatedPrice        Float?                    @map("estimated_price")
  contractStartDate     DateTime?                 @map("contract_start_date")
  contractEndDate       DateTime?                 @map("contract_end_date")
  contractRenewalCost   Float?                    @map("contract_renewal_cost")
  contractId            String?                   @map("contract_id")
  createdAt             DateTime                  @default(now()) @map("created_at")
  updatedAt             DateTime                  @updatedAt @map("updated_at")
  consumables           consumables[]
  decommission_requests decommission_requests[]
  contract              software_licenses?        @relation("EquipmentContract", fields: [contractId], references: [id])
  department            departments?              @relation(fields: [departmentId], references: [id])
  supplier              suppliers?                @relation(fields: [supplierId], references: [id])
  type                  equipment_types           @relation(fields: [typeId], references: [id])
  warehouse             warehouses?               @relation(fields: [warehouseId], references: [id])
  assignments           equipment_assignments[]
  attachments           equipment_attachments[]
  maintenanceRecords    maintenance_records[]
  licenses              software_licenses[]
  stockMovements        stock_movements[]         @relation("StockMovementEquipment")
  contractLines         contract_lines[]          @relation("ContractLineEquipment")
  sale                  equipment_sales?
  customValues          equipment_custom_values[]
  credentialEntries     credential_entries[]

  @@index([code])
  @@index([serialNumber])
  @@index([modelId, status])
  @@index([batchId])
  @@index([typeId, status])
  @@index([status])
  @@index([departmentId])
  @@index([rentalProvider])
  @@index([rentalEndDate])
  @@index([status, createdAt(sort: Desc)])
  @@index([departmentId, status])
  @@index([createdAt(sort: Desc)])
  @@index([supplierId])
  @@index([warehouseId])
  @@map("equipment")
}

