model contracts {
  id                String           @id @default(uuid())
  contractNumber    String?          @map("contract_number") @db.VarChar(100)
  name              String           @db.VarChar(200)
  description       String?
  category          ContractCategory @default(SERVICE)
  /// Código del catálogo contract_service_types (antes enum SubscriptionServiceType)
  serviceSubtype    String?          @map("service_subtype") @db.VarChar(50)
  status            ContractStatus   @default(DRAFT)
  supplierId        String?          @map("supplier_id")
  familyId          String?          @map("family_id")
  modelId           String?          @map("model_id")
  batchId           String?          @map("batch_id")
  startDate         DateTime?        @map("start_date")
  endDate           DateTime?        @map("end_date")
  autoRenew         Boolean          @default(false) @map("auto_renew")
  renewalNoticeDays Int              @default(30) @map("renewal_notice_days")
  billingCycle      BillingCycle     @default(MONTHLY) @map("billing_cycle")
  totalValue        Float?           @map("total_value")
  monthlyCost       Float?           @map("monthly_cost")
  currency          String           @default("USD") @db.VarChar(3)
  contactName       String?          @map("contact_name") @db.VarChar(200)
  contactEmail      String?          @map("contact_email") @db.VarChar(200)
  contactPhone      String?          @map("contact_phone") @db.VarChar(50)
  notes             String?
  termsUrl          String?          @map("terms_url") @db.VarChar(500)
  expiryAlertSentAt DateTime?        @map("expiry_alert_sent_at")

  // Alertas de vencimiento
  alert60DaysSent Boolean   @default(false) @map("alert_60_days_sent")
  alert30DaysSent Boolean   @default(false) @map("alert_30_days_sent")
  alert15DaysSent Boolean   @default(false) @map("alert_15_days_sent")
  lastAlertSentAt DateTime? @map("last_alert_sent_at")

  // Renovación
  renewedFromId String? @map("renewed_from_id")
  renewedToId   String? @map("renewed_to_id")
  renewalCount  Int     @default(0) @map("renewal_count")

  // Gobernanza de suscripciones / facturación recurrente
  custodianUserId         String?                  @map("custodian_user_id")
  backupCustodianUserId   String?                  @map("backup_custodian_user_id")
  billingAccountEmail     String?                  @map("billing_account_email") @db.VarChar(200)
  billingPortalUrl        String?                  @map("billing_portal_url") @db.VarChar(500)
  vendorAccountId         String?                  @map("vendor_account_id") @db.VarChar(200)
  paymentMethodType       PaymentMethodType        @default(CORPORATE_CARD) @map("payment_method_type")
  paymentAccountRef       String?                  @map("payment_account_ref") @db.VarChar(300)
  paymentCardBrand        String?                  @map("payment_card_brand") @db.VarChar(50)
  paymentCardLast4        String?                  @map("payment_card_last4") @db.VarChar(4)
  paymentCardBank         String?                  @map("payment_card_bank") @db.VarChar(100)
  paymentCardExpiry       String?                  @map("payment_card_expiry") @db.VarChar(7)
  corporateCardLabel      String?                  @map("corporate_card_label") @db.VarChar(100)
  lastChargeDate          DateTime?                @map("last_charge_date")
  lastChargeAmount        Float?                   @map("last_charge_amount")
  lastTransactionRef      String?                  @map("last_transaction_ref") @db.VarChar(200)
  subscriptionUsageStatus SubscriptionUsageStatus  @default(ACTIVE) @map("subscription_usage_status")
  cancellationNoticeDays  Int?                     @map("cancellation_notice_days")

  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  creator            users                  @relation("ContractCreator", fields: [createdBy], references: [id])
  custodian          users?                 @relation("ContractCustodian", fields: [custodianUserId], references: [id], onDelete: SetNull)
  backupCustodian    users?                 @relation("ContractBackupCustodian", fields: [backupCustodianUserId], references: [id], onDelete: SetNull)
  supplier           suppliers?             @relation(fields: [supplierId], references: [id])
  family             families?              @relation(fields: [familyId], references: [id])
  model        equipment_models?      @relation("ContractModel", fields: [modelId], references: [id], onDelete: SetNull)
  batch        equipment_batches?     @relation("ContractBatch", fields: [batchId], references: [id], onDelete: SetNull)
  renewedFrom  contracts?             @relation("ContractRenewalFrom", fields: [renewedFromId], references: [id], onDelete: SetNull)
  renewedTo    contracts?             @relation("ContractRenewalTo", fields: [renewedToId], references: [id], onDelete: SetNull)
  renewalsFrom contracts[]            @relation("ContractRenewalFrom")
  renewalsTo   contracts[]            @relation("ContractRenewalTo")
  lines        contract_lines[]
  attachments  contract_attachments[]
  payments     contract_payments[]    @relation("ContractPayments")
  assignments  contract_assignments[]
  amendments   contract_amendments[]
  maintenances maintenance_records[]

  @@index([status, endDate])
  @@index([supplierId])
  @@index([familyId])
  @@index([custodianUserId])
  @@index([subscriptionUsageStatus])
  @@index([paymentMethodType])
  @@index([serviceSubtype])
  @@index([modelId])
  @@index([batchId])
  @@index([createdBy])
  @@index([renewedFromId])
  @@index([renewedToId])
  @@index([createdAt(sort: Desc)])
  @@map("contracts")
}

model contract_lines {
  id          String           @id @default(uuid())
  contractId  String           @map("contract_id")
  type        ContractLineType @default(SERVICE)
  description String           @db.VarChar(500)
  quantity    Float            @default(1)
  unitPrice   Float?           @map("unit_price")
  totalPrice  Float?           @map("total_price")
  equipmentId String?          @map("equipment_id")
  licenseId   String?          @map("license_id")
  notes       String?
  order       Int              @default(0)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  contract  contracts          @relation(fields: [contractId], references: [id], onDelete: Cascade)
  equipment equipment?         @relation("ContractLineEquipment", fields: [equipmentId], references: [id], onDelete: SetNull)
  license   software_licenses? @relation("ContractLineLicense", fields: [licenseId], references: [id], onDelete: SetNull)

  @@index([contractId])
  @@index([equipmentId])
  @@index([licenseId])
  @@map("contract_lines")
}

model contract_amendments {
  id                   String                  @id @default(uuid())
  contractId           String                  @map("contract_id")
  folio                String                  @unique @db.VarChar(50)
  amendmentNumber      Int                     @map("amendment_number")
  title                String                  @db.VarChar(200)
  description          String?
  type                 ContractAmendmentType   @default(OTHER)
  status               ContractAmendmentStatus @default(ACTIVE)
  effectiveDate        DateTime                @map("effective_date")
  applyToContract      Boolean                 @default(true) @map("apply_to_contract")
  previousMonthlyCost  Float?                  @map("previous_monthly_cost")
  newMonthlyCost       Float?                  @map("new_monthly_cost")
  previousTotalValue   Float?                  @map("previous_total_value")
  newTotalValue        Float?                  @map("new_total_value")
  previousEndDate      DateTime?               @map("previous_end_date")
  newEndDate           DateTime?               @map("new_end_date")
  previousBillingCycle BillingCycle?           @map("previous_billing_cycle")
  newBillingCycle      BillingCycle?           @map("new_billing_cycle")
  createdBy            String                  @map("created_by")
  createdAt            DateTime                @default(now()) @map("created_at")
  updatedAt            DateTime                @updatedAt @map("updated_at")

  contract contracts @relation(fields: [contractId], references: [id], onDelete: Cascade)
  creator  users     @relation("ContractAmendmentCreator", fields: [createdBy], references: [id])

  @@unique([contractId, amendmentNumber])
  @@index([contractId, effectiveDate])
  @@index([folio])
  @@map("contract_amendments")
}

model contract_attachments {
  id           String   @id @default(uuid())
  contractId   String   @map("contract_id")
  filename     String   @db.VarChar(255)
  originalName String   @map("original_name") @db.VarChar(255)
  mimeType     String   @map("mime_type") @db.VarChar(100)
  size         Int
  path         String   @db.VarChar(500)
  uploadedBy   String   @map("uploaded_by")
  createdAt    DateTime @default(now()) @map("created_at")

  contract contracts @relation(fields: [contractId], references: [id], onDelete: Cascade)
  uploader users     @relation("ContractAttachmentUploader", fields: [uploadedBy], references: [id])

  @@index([contractId])
  @@map("contract_attachments")
}

// ── Pagos de contratos ────────────────────────────────────────────────────────

enum PaymentStatus {
  SCHEDULED // Pago programado, aún no vence
  DUE // Pago vencido hoy
  OVERDUE // Pago vencido (pasó la fecha)
  PAID // Pago realizado
  CANCELLED // Pago cancelado
}

model contract_payments {
  id              String        @id @default(uuid())
  contractId      String        @map("contract_id")
  amount          Float
  currency        String        @default("USD") @db.VarChar(3)
  dueDate         DateTime      @map("due_date")
  paidDate        DateTime?     @map("paid_date")
  status          PaymentStatus @default(SCHEDULED)
  paymentMethod   String?       @map("payment_method") @db.VarChar(100)
  referenceNumber String?       @map("reference_number") @db.VarChar(200)
  notes           String?
  cardLast4       String?       @map("card_last4") @db.VarChar(4)
  cardBrand       String?       @map("card_brand") @db.VarChar(50)
  bankEntity      String?       @map("bank_entity") @db.VarChar(100)
  statementPeriod DateTime?     @map("statement_period")
  transactionId   String?       @map("transaction_id") @db.VarChar(200)
  chargeSource    String?       @map("charge_source") @db.VarChar(50)

  // Alertas de pago próximo
  alert7DaysSent   Boolean   @default(false) @map("alert_7_days_sent")
  alertDueSent     Boolean   @default(false) @map("alert_due_sent")
  alertOverdueSent Boolean   @default(false) @map("alert_overdue_sent")
  lastAlertSentAt  DateTime? @map("last_alert_sent_at")

  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  contract contracts @relation("ContractPayments", fields: [contractId], references: [id], onDelete: Cascade)
  creator  users     @relation("PaymentCreator", fields: [createdBy], references: [id])

  @@index([contractId, dueDate])
  @@index([status, dueDate])
  @@index([createdBy])
  @@index([dueDate])
  @@map("contract_payments")
}

model contract_assignments {
  id            String    @id @default(uuid())
  contractId    String    @map("contract_id")
  clientId      String    @map("client_id")
  delivererId   String    @map("deliverer_id")
  familyId      String    @map("family_id")
  startDate     DateTime  @map("start_date")
  plannedEndDate DateTime? @map("planned_end_date")
  actualEndDate DateTime? @map("actual_end_date")
  isActive      Boolean   @default(true) @map("is_active")
  changeReason  String?   @map("change_reason")
  notes         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  contract    contracts            @relation(fields: [contractId], references: [id], onDelete: Cascade)
  client      users                @relation("ContractAssignmentClient", fields: [clientId], references: [id])
  deliverer   users                @relation("ContractAssignmentDeliverer", fields: [delivererId], references: [id])
  family      families             @relation(fields: [familyId], references: [id])
  deliveryAct delivery_acts?
  returnAct   contract_return_acts?

  @@index([contractId, isActive])
  @@index([clientId, isActive])
  @@index([familyId])
  @@map("contract_assignments")
}

model contract_return_acts {
  id                   String             @id @default(uuid())
  folio                String             @unique
  contractAssignmentId String             @unique @map("contract_assignment_id")
  deliveryActId        String             @map("delivery_act_id")
  contractSnapshot     Json               @map("contract_snapshot")
  withdrawalReason     String?            @map("withdrawal_reason")
  handoverNotes        String?            @map("handover_notes")
  returnDate           DateTime           @map("return_date")
  receiverInfo         Json               @map("receiver_info")
  delivererInfo        Json               @map("deliverer_info")
  status               ActStatus          @default(PENDING)
  acceptanceToken      String             @unique @map("acceptance_token")
  expirationDate       DateTime           @map("expiration_date")
  acceptedAt           DateTime?          @map("accepted_at")
  rejectedAt           DateTime?          @map("rejected_at")
  rejectionReason      String?            @map("rejection_reason")
  signatureTimestamp   DateTime?          @map("signature_timestamp")
  signatureIp          String?            @map("signature_ip")
  signatureUserAgent   String?            @map("signature_user_agent")
  verificationHash     String?            @map("verification_hash")
  pdfPath              String?            @map("pdf_path")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  contractAssignment contract_assignments @relation(fields: [contractAssignmentId], references: [id])

  @@index([folio])
  @@index([status, expirationDate])
  @@index([acceptanceToken])
  @@map("contract_return_acts")
}

// ── Ventas de activos ─────────────────────────────────────────────────────────

enum SaleStatus {
  PENDING // Solicitud creada, esperando aprobación del admin
  APPROVED // Admin aprobó — equipo marcado como SOLD
  REJECTED // Admin rechazó la solicitud
}

model equipment_sales {
  id            String  @id @default(uuid())
  equipmentId   String  @unique @map("equipment_id") // un equipo solo puede venderse una vez
  requestedById String  @map("requested_by_id") // quien solicita (ADMIN o SUPER_ADMIN)
  approvedById  String? @map("approved_by_id") // quien aprueba (ADMIN o SUPER_ADMIN)

  status SaleStatus @default(PENDING)

  // Datos del comprador — solo visibles para ADMIN / SUPER_ADMIN
  buyerName     String  @map("buyer_name") @db.VarChar(200)
  buyerCompany  String? @map("buyer_company") @db.VarChar(200)
  buyerIdNumber String? @map("buyer_id_number") @db.VarChar(50) // RUC / cédula

  // Datos financieros de la venta
  salePrice     Float    @map("sale_price")
  saleDate      DateTime @map("sale_date")
  invoiceNumber String?  @map("invoice_number") @db.VarChar(100)
  paymentMethod String?  @map("payment_method") @db.VarChar(50) // CASH, CARD, TRANSFER, DISCOUNT

  // Accesorios incluidos en la venta (puede diferir de los del equipo)
  accessories String[]

  // Notas internas
  notes           String?
  rejectionReason String? @map("rejection_reason")

  // Timestamps
  approvedAt DateTime? @map("approved_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  equipment   equipment @relation(fields: [equipmentId], references: [id])
  requestedBy users     @relation("SaleRequester", fields: [requestedById], references: [id])
  approvedBy  users?    @relation("SaleApprover", fields: [approvedById], references: [id])

  @@index([status, createdAt(sort: Desc)])
  @@index([requestedById])
  @@index([approvedById])
  @@map("equipment_sales")
}

// ── Solicitudes de Activos ────────────────────────────────────────────────────

enum AssetRequestStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  FULFILLED
}

enum AssetType {
  EQUIPMENT
  LICENSE
  OTHER
}

model asset_requests {
  id String @id @default(uuid())

  /// Código único — formato AR-{YEAR}-{SEQUENCE}
  code String @unique @db.VarChar(30)

  /// Tipo de activo solicitado
  assetType AssetType @map("asset_type")

  /// Descripción de la necesidad (min 10 chars)
  description String

  /// Justificación del requerimiento (min 10 chars)
  justification String

  /// Cantidad requerida (default 1)
  quantity Int @default(1)

  /// Fecha estimada de necesidad (opcional)
  neededBy DateTime? @map("needed_by")

  /// Referencia opcional a un activo del catálogo
  assetId         String? @map("asset_id")
  assetEntityType String? @map("asset_entity_type") @db.VarChar(20)

  /// Familia a la que pertenece la solicitud
  familyId String @map("family_id")

  /// Solicitante
  requesterId String @map("requester_id")

  /// Estado del ciclo de vida
  status AssetRequestStatus @default(PENDING)

  /// Comentario del Super Admin al aprobar/rechazar (obligatorio, min 10 chars)
  reviewerComment String?   @map("reviewer_comment")
  reviewedById    String?   @map("reviewed_by_id")
  reviewedAt      DateTime? @map("reviewed_at")

  /// Entrega (FULFILLED)
  fulfilledById String?   @map("fulfilled_by_id")
  fulfilledAt   DateTime? @map("fulfilled_at")

  /// Comentarios internos de revisión — JSON array
  /// Cada entrada: { id, userId, userName, userRole, comment, createdAt }
  reviewComments Json @default("[]") @map("review_comments")

  /// SLA - Deadline de resolución
  slaDeadline DateTime? @map("sla_deadline")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relaciones
  family                    families                   @relation(fields: [familyId], references: [id])
  requester                 users                      @relation("AssetRequestRequester", fields: [requesterId], references: [id])
  reviewedBy                users?                     @relation("AssetRequestReviewer", fields: [reviewedById], references: [id])
  fulfilledBy               users?                     @relation("AssetRequestFulfiller", fields: [fulfilledById], references: [id])
  asset_request_sla_metrics asset_request_sla_metrics?
  sla_violations            sla_violations[]

  // Índices de performance
  @@index([familyId, status, createdAt(sort: Desc)])
  @@index([requesterId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([code])
  @@index([familyId, createdAt(sort: Desc)])
  @@index([reviewedById])
  @@index([fulfilledById])
  @@index([slaDeadline])
  @@map("asset_requests")
}

/// Métricas SLA para solicitudes de activos — similar a ticket_sla_metrics
model asset_request_sla_metrics {
  id                     String    @id @default(uuid())
  assetRequestId         String    @unique @map("asset_request_id")
  slaPolicyId            String    @map("sla_policy_id")
  responseDeadline       DateTime? @map("response_deadline")
  resolutionDeadline     DateTime? @map("resolution_deadline")
  firstResponseAt        DateTime? @map("first_response_at")
  fulfilledAt            DateTime? @map("fulfilled_at")
  responseSLAMet         Boolean?  @map("response_sla_met")
  resolutionSLAMet       Boolean?  @map("resolution_sla_met")
  responseTimeMinutes    Int?      @map("response_time_minutes")
  fulfillmentTimeMinutes Int?      @map("fulfillment_time_minutes")
  businessHoursElapsed   Int?      @map("business_hours_elapsed")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  sla_policy     sla_policies   @relation(fields: [slaPolicyId], references: [id])
  asset_requests asset_requests @relation(fields: [assetRequestId], references: [id], onDelete: Cascade)

  @@index([assetRequestId])
  @@index([responseDeadline, resolutionDeadline])
  @@map("asset_request_sla_metrics")
}

// ═══════════════════════════════════════════════════════════════════════════
// ATRIBUTOS DINÁMICOS POR FAMILIA
// ═══════════════════════════════════════════════════════════════════════════

/// Definición de campos personalizados por familia
/// Permite a cada familia definir sus propios atributos (color, talla, material, etc.)
model family_custom_fields {
  id       String   @id @default(uuid())
  familyId String   @map("family_id")
  family   families @relation(fields: [familyId], references: [id], onDelete: Cascade)

  fieldName    String  @map("field_name") @db.VarChar(50) // "color", "talla", "material"
  fieldLabel   String  @map("field_label") @db.VarChar(100) // "Color", "Talla", "Material"
  fieldType    String  @map("field_type") @db.VarChar(20) // "text", "number", "select", "date", "boolean"
  fieldOptions Json?   @map("field_options") // ["Rojo", "Azul"] para select, { min: 0, max: 100 } para number
  isRequired   Boolean @default(false) @map("is_required")
  order        Int     @default(0)
  helpText     String? @map("help_text") @db.VarChar(255) // Texto de ayuda para el usuario

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([familyId, fieldName])
  @@index([familyId, order])
  @@map("family_custom_fields")
}

/// Valores de campos personalizados por equipo
/// Almacena los valores específicos de cada atributo para cada equipo
model equipment_custom_values {
  id          String    @id @default(uuid())
  equipmentId String    @map("equipment_id")
  equipment   equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  fieldName  String @map("field_name") @db.VarChar(50) // "color"
  fieldValue String @map("field_value") @db.VarChar(255) // "Rojo"

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([equipmentId, fieldName])
  @@index([equipmentId])
  @@index([fieldName, fieldValue])
  @@map("equipment_custom_values")
}

// ── Patrol Module ─────────────────────────────────────────────────────────────

enum PatrolStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  MISSED
  INCOMPLETE
}

enum QRType {
  DYNAMIC
  STATIC
}

enum CheckInValidationResult {
  VALID
  QR_TOKEN_INVALID
  GPS_OUT_OF_GEOFENCE
  OFFLINE_SYNC_REJECTED
}

enum CheckInMethod {
  QR_DYNAMIC
  QR_STATIC
  OFFLINE_SYNC
}

enum PatrolRecurrence {
  NONE
  DAILY
  WEEKLY
  CUSTOM
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  OPEN
  RESOLVED
  ESCALATED
}

model patrol_family_config {
  id                          String   @id @default(uuid())
  familyId                    String   @unique @map("family_id")
  patrolsEnabled              Boolean  @default(true) @map("patrols_enabled")
  qrWindowMinutes             Int      @default(5) @map("qr_window_minutes")
  geofenceRadiusMeters        Int      @default(1) @map("geofence_radius_meters")
  photoRetentionDays          Int      @default(90) @map("photo_retention_days")
  photoCompressionQuality     Float    @default(0.82) @map("photo_compression_quality")
  photoMaxWidthPx             Int      @default(1280) @map("photo_max_width_px")
  requirePhotoOnStart         Boolean  @default(false) @map("require_photo_on_start")
  requirePhotoOnEnd           Boolean  @default(false) @map("require_photo_on_end")
  /// Al registrar el último checkpoint obligatorio, cerrar la ronda como COMPLETED (si no exige foto de cierre).
  autoCompleteWhenAllRequired Boolean  @default(true) @map("auto_complete_when_all_required")
  offlineSyncToleranceMinutes Int      @default(30) @map("offline_sync_tolerance_minutes")
  alertCompletionThreshold    Int      @default(80) @map("alert_completion_threshold")
  gracePeriodMinutes          Int      @default(5) @map("grace_period_minutes")
  strictTimeValidation        Boolean  @default(true) @map("strict_time_validation")
  reminderMinutesBefore       Int      @default(5) @map("reminder_minutes_before")
  patrolIncidentCategoryId    String?  @map("patrol_incident_category_id")
  createdAt                   DateTime @default(now()) @map("created_at")
  updatedAt                   DateTime @updatedAt @map("updated_at")

  family           families    @relation(fields: [familyId], references: [id], onDelete: Cascade)
  incidentCategory categories? @relation("PatrolIncidentCategory", fields: [patrolIncidentCategoryId], references: [id])

  @@index([familyId])
  @@map("patrol_family_config")
}

model patrol_checkpoints {
  id                   String   @id @default(uuid())
  familyId             String   @map("family_id")
  name                 String   @db.VarChar(200)
  description          String?
  location             String   @db.VarChar(500)
  latitude             Float?
  longitude            Float?
  geofenceRadiusMeters Int?     @map("geofence_radius_meters")
  hasConnectivity      Boolean  @default(true) @map("has_connectivity")
  isSensitive          Boolean  @default(false) @map("is_sensitive")
  isActive             Boolean  @default(true) @map("is_active")
  qrType               QRType   @default(DYNAMIC) @map("qr_type")
  qrSecret             String   @map("qr_secret")
  qrStaticToken        String?  @map("qr_static_token")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  family           families                   @relation(fields: [familyId], references: [id])
  routeCheckpoints patrol_route_checkpoints[]
  checkIns         patrol_check_ins[]
  incidents        patrol_incidents[]

  @@index([familyId, isActive])
  @@index([qrType, isActive])
  @@map("patrol_checkpoints")
}

model patrol_routes {
  id                       String   @id @default(uuid())
  familyId                 String   @map("family_id")
  name                     String   @db.VarChar(200)
  description              String?
  estimatedDurationMinutes Int      @map("estimated_duration_minutes")
  isActive                 Boolean  @default(true) @map("is_active")
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  family           families                   @relation(fields: [familyId], references: [id])
  routeCheckpoints patrol_route_checkpoints[]
  schedules        patrol_schedules[]
  patrols          patrols[]

  @@index([familyId, isActive])
  @@map("patrol_routes")
}

model patrol_route_checkpoints {
  id           String   @id @default(uuid())
  routeId      String   @map("route_id")
  checkpointId String   @map("checkpoint_id")
  order        Int
  isRequired   Boolean  @default(true) @map("is_required")
  createdAt    DateTime @default(now()) @map("created_at")

  route      patrol_routes      @relation(fields: [routeId], references: [id], onDelete: Cascade)
  checkpoint patrol_checkpoints @relation(fields: [checkpointId], references: [id])

  @@unique([routeId, checkpointId])
  @@unique([routeId, order])
  @@index([routeId, order])
  @@index([checkpointId])
  @@map("patrol_route_checkpoints")
}

model patrol_schedules {
  id                    String           @id @default(uuid())
  familyId              String           @map("family_id")
  routeId               String           @map("route_id")
  agentId               String           @map("agent_id")
  scheduledStart        DateTime         @map("scheduled_start")
  scheduledEnd          DateTime         @map("scheduled_end")
  recurrence            PatrolRecurrence @default(NONE)
  recurrenceDays        Int[]            @default([]) @map("recurrence_days")
  isActive              Boolean          @default(true) @map("is_active")
  /// null = usar el default de patrol_family_config.strictTimeValidation
  /// true = forzar validación estricta para esta programación
  /// false = deshabilitar validación de horario solo para esta programación
  overrideTimeValidation Boolean?        @map("override_time_validation")
  createdAt             DateTime         @default(now()) @map("created_at")
  updatedAt             DateTime         @updatedAt @map("updated_at")

  family  families      @relation(fields: [familyId], references: [id])
  route   patrol_routes @relation(fields: [routeId], references: [id])
  agent   users         @relation("PatrolAgent", fields: [agentId], references: [id])
  patrols patrols[]

  @@index([agentId, isActive])
  @@index([familyId, isActive])
  @@index([routeId, isActive])
  @@map("patrol_schedules")
}

model patrols {
  id                   String       @id @default(uuid())
  familyId             String       @map("family_id")
  scheduleId           String?      @map("schedule_id")
  routeId              String       @map("route_id")
  agentId              String       @map("agent_id")
  status               PatrolStatus @default(PENDING)
  scheduledStart       DateTime     @map("scheduled_start")
  scheduledEnd         DateTime     @map("scheduled_end")
  startedAt            DateTime?    @map("started_at")
  completedAt          DateTime?    @map("completed_at")
  completionPercentage Float        @default(0) @map("completion_percentage")
  missedCheckpointIds  String[]     @default([]) @map("missed_checkpoint_ids")
  startPhotoId         String?      @map("start_photo_id")
  endPhotoId           String?      @map("end_photo_id")
  reminderSentAt       DateTime?    @map("reminder_sent_at")
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")

  family     families           @relation(fields: [familyId], references: [id])
  schedule   patrol_schedules?  @relation(fields: [scheduleId], references: [id])
  route      patrol_routes      @relation(fields: [routeId], references: [id])
  agent      users              @relation("PatrolAgentExecution", fields: [agentId], references: [id])
  checkIns   patrol_check_ins[]
  incidents  patrol_incidents[]
  startPhoto patrol_photos?     @relation("PatrolStartPhoto", fields: [startPhotoId], references: [id])
  endPhoto   patrol_photos?     @relation("PatrolEndPhoto", fields: [endPhotoId], references: [id])

  @@unique([scheduleId, scheduledStart], name: "patrol_schedule_start_unique")
  @@index([agentId, status])
  @@index([familyId, scheduledStart])
  @@index([status, scheduledStart])
  @@index([scheduleId, status])
  @@map("patrols")
}

model patrol_check_ins {
  id                           String                  @id @default(uuid())
  patrolId                     String                  @map("patrol_id")
  checkpointId                 String                  @map("checkpoint_id")
  agentId                      String                  @map("agent_id")
  submittedTokenHash           String                  @map("submitted_token_hash")
  gpsLat                       Float?                  @map("gps_lat")
  gpsLng                       Float?                  @map("gps_lng")
  gpsAccuracyMeters            Float?                  @map("gps_accuracy_meters")
  distanceFromCheckpointMeters Float?                  @map("distance_from_checkpoint_meters")
  validationResult             CheckInValidationResult @map("validation_result")
  method                       CheckInMethod           @map("method")
  deviceTimestamp              DateTime                @map("device_timestamp")
  serverTimestamp              DateTime                @default(now()) @map("server_timestamp")
  syncedAt                     DateTime?               @map("synced_at")
  isOffline                    Boolean                 @default(false) @map("is_offline")
  createdAt                    DateTime                @default(now()) @map("created_at")

  patrol     patrols            @relation(fields: [patrolId], references: [id], onDelete: Cascade)
  checkpoint patrol_checkpoints @relation(fields: [checkpointId], references: [id])
  agent      users              @relation("PatrolCheckInAgent", fields: [agentId], references: [id])
  photos     patrol_photos[]
  tickets    tickets[]

  @@index([patrolId, checkpointId])
  @@index([patrolId, createdAt(sort: Desc)])
  @@index([checkpointId, validationResult])
  @@map("patrol_check_ins")
}

model patrol_photos {
  id         String    @id @default(uuid())
  checkInId  String?   @map("check_in_id")
  patrolId   String?   @map("patrol_id")
  incidentId String?   @map("incident_id")
  path       String
  size       Int
  mimeType   String    @map("mime_type")
  capturedAt DateTime  @map("captured_at")
  deletedAt  DateTime? @map("deleted_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  checkIn     patrol_check_ins?  @relation(fields: [checkInId], references: [id])
  incident    patrol_incidents?  @relation(fields: [incidentId], references: [id], onDelete: SetNull)
  patrolStart patrols[]          @relation("PatrolStartPhoto")
  patrolEnd   patrols[]          @relation("PatrolEndPhoto")

  @@index([checkInId])
  @@index([patrolId])
  @@index([incidentId])
  @@index([capturedAt(sort: Desc)])
  @@index([deletedAt])
  @@map("patrol_photos")
}

model patrol_incidents {
  id            String           @id @default(uuid())
  patrolId      String           @map("patrol_id")
  checkpointId  String           @map("checkpoint_id")
  agentId       String           @map("agent_id")
  description   String
  severity      IncidentSeverity
  status        IncidentStatus   @default(OPEN)
  photoIds      String[]         @default([]) @map("photo_ids")
  ticketId      String?          @map("ticket_id")
  resolvedAt    DateTime?        @map("resolved_at")
  resolvedById  String?          @map("resolved_by_id")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  patrol     patrols            @relation(fields: [patrolId], references: [id], onDelete: Cascade)
  checkpoint patrol_checkpoints @relation(fields: [checkpointId], references: [id])
  agent      users              @relation("IncidentAgent", fields: [agentId], references: [id])
  ticket     tickets?           @relation(fields: [ticketId], references: [id])
  resolvedBy users?             @relation("IncidentResolver", fields: [resolvedById], references: [id])
  photos     patrol_photos[]

  @@index([patrolId, createdAt(sort: Desc)])
  @@index([agentId, createdAt(sort: Desc)])
  @@index([checkpointId, status])
  @@index([status, severity])
  @@index([ticketId])
  @@map("patrol_incidents")
}

// ============================================
// NEWS AND COMMUNICATIONS MODULE
// ============================================

enum NewsType {
  NEWS
  ANNOUNCEMENT
  EVENT
  BIRTHDAY
  HOLIDAY
  ALERT
  INTERNAL_AD
  RECOGNITION
}

enum NewsPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum NewsStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model news {
  id             String       @id @default(uuid())
  title          String       @db.VarChar(200)
  slug           String       @unique @db.VarChar(200)
  content        String?
  summary        String?      @db.VarChar(500)
  imageUrl       String?      @map("image_url")
  type           NewsType     @default(NEWS)
  priority       NewsPriority @default(MEDIUM)
  status         NewsStatus   @default(DRAFT)
  startDate      DateTime?    @map("start_date")
  endDate        DateTime?    @map("end_date")
  isFeatured     Boolean      @default(false) @map("is_featured")
  allowComments  Boolean      @default(false) @map("allow_comments")
  allowReactions Boolean      @default(true) @map("allow_reactions")
  views          Int          @default(0)
  createdById    String       @map("created_by_id")
  updatedById    String?      @map("updated_by_id")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  createdBy        users              @relation("NewsCreator", fields: [createdById], references: [id])
  updatedBy        users?             @relation("NewsUpdater", fields: [updatedById], references: [id])
  news_roles       news_roles[]
  news_users       news_users[]
  news_departments news_departments[]
  news_families    news_families[]
  news_views       news_views[]
  news_reactions   news_reactions[]
  news_comments    news_comments[]
  news_attachments news_attachments[]

  @@index([type, status])
  @@index([status, createdAt(sort: Desc)])
  @@index([isFeatured, status])
  @@index([startDate, endDate])
  @@map("news")
}

model news_roles {
  id        String   @id @default(uuid())
  newsId    String   @map("news_id")
  role      UserRole
  createdAt DateTime @default(now()) @map("created_at")

  news news @relation(fields: [newsId], references: [id], onDelete: Cascade)

  @@unique([newsId, role])
  @@index([newsId])
  @@index([role])
  @@map("news_roles")
}

model news_users {
  id        String   @id @default(uuid())
  newsId    String   @map("news_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  news news  @relation(fields: [newsId], references: [id], onDelete: Cascade)
  user users @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([newsId, userId])
  @@index([newsId])
  @@index([userId])
  @@map("news_users")
}

model news_departments {
  id           String   @id @default(uuid())
  newsId       String   @map("news_id")
  departmentId String   @map("department_id")
  createdAt    DateTime @default(now()) @map("created_at")

  news        news        @relation(fields: [newsId], references: [id], onDelete: Cascade)
  departments departments @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([newsId, departmentId])
  @@index([newsId])
  @@index([departmentId])
  @@map("news_departments")
}

model news_families {
  id        String   @id @default(uuid())
  newsId    String   @map("news_id")
  familyId  String   @map("family_id")
  createdAt DateTime @default(now()) @map("created_at")

  news     news     @relation(fields: [newsId], references: [id], onDelete: Cascade)
  families families @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@unique([newsId, familyId])
  @@index([newsId])
  @@index([familyId])
  @@map("news_families")
}

model news_views {
  id       String   @id @default(uuid())
  newsId   String   @map("news_id")
  userId   String   @map("user_id")
  viewedAt DateTime @default(now()) @map("viewed_at")

  news news  @relation(fields: [newsId], references: [id], onDelete: Cascade)
  user users @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([newsId, userId])
  @@index([newsId])
  @@index([userId])
  @@index([viewedAt(sort: Desc)])
  @@map("news_views")
}

model news_reactions {
  id        String   @id @default(uuid())
  newsId    String   @map("news_id")
  userId    String   @map("user_id")
  reaction  String   @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at")

  news news  @relation(fields: [newsId], references: [id], onDelete: Cascade)
  user users @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([newsId, userId])
  @@index([newsId])
  @@index([userId])
  @@map("news_reactions")
}

model news_comments {
  id        String   @id @default(uuid())
  newsId    String   @map("news_id")
  userId    String   @map("user_id")
  content   String
  parentId  String?  @map("parent_id")
  isHidden  Boolean  @default(false) @map("is_hidden")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  news    news            @relation(fields: [newsId], references: [id], onDelete: Cascade)
  user    users           @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent  news_comments?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies news_comments[] @relation("CommentReplies")

  @@index([newsId, createdAt(sort: Desc)])
  @@index([userId])
  @@map("news_comments")
}

model news_attachments {
  id           String   @id @default(uuid())
  newsId       String   @map("news_id")
  filename     String
  originalName String   @map("original_name")
  mimeType     String   @map("mime_type")
  size         Int
  path         String
  uploadedById String   @map("uploaded_by_id")
  createdAt    DateTime @default(now()) @map("created_at")

  news       news  @relation(fields: [newsId], references: [id], onDelete: Cascade)
  uploadedBy users @relation("NewsAttachmentUploader", fields: [uploadedById], references: [id])

  @@index([newsId])
  @@map("news_attachments")
}

// ─────────────────────────────────────────────────────────────────────────────
// MÓDULO DE FORMULARIOS Y DOCUMENTOS
// ─────────────────────────────────────────────────────────────────────────────

model form_categories {
  id          String   @id @default(uuid())
  name        String   @db.VarChar(100)
  description String?
  color       String?  @default("#6B7280")
  isActive    Boolean  @default(true)
  order       Int      @default(0)
  familyId    String?  @map("family_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  family families? @relation(fields: [familyId], references: [id])
  forms  forms[]

  @@index([familyId])
  @@index([isActive, order])
  @@map("form_categories")
}

model forms {
  id            String   @id @default(uuid())
  title         String   @db.VarChar(200)
  slug          String   @unique @db.VarChar(200)
  description   String?
  summary       String?  @db.VarChar(500)
  version       String?  @db.VarChar(50)
  categoryId    String   @map("category_id")
  familyId      String?  @map("family_id")
  fileUrl       String?  @map("file_url")
  fileSize      Int?     @map("file_size")
  fileType      String?  @map("file_type") @db.VarChar(100)
  downloadCount Int      @default(0) @map("download_count")
  isActive      Boolean  @default(true) @map("is_active")
  isFeatured    Boolean  @default(false) @map("is_featured")
  createdById   String   @map("created_by_id")
  updatedById   String?  @map("updated_by_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  category         form_categories    @relation(fields: [categoryId], references: [id])
  family           families?          @relation(fields: [familyId], references: [id])
  createdBy        users              @relation("FormCreator", fields: [createdById], references: [id])
  updatedBy        users?             @relation("FormUpdater", fields: [updatedById], references: [id])
  form_roles       form_roles[]
  form_users       form_users[]
  form_departments form_departments[]
  form_families    form_families[]
  form_downloads   form_downloads[]
  form_attachments form_attachments[]

  @@index([categoryId])
  @@index([familyId])
  @@index([isActive, createdAt(sort: Desc)])
  @@index([isFeatured, isActive])
  @@map("forms")
}

model form_roles {
  id        String   @id @default(uuid())
  formId    String   @map("form_id")
  role      UserRole
  createdAt DateTime @default(now()) @map("created_at")

  form forms @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@unique([formId, role])
  @@index([formId])
  @@map("form_roles")
}

model form_users {
  id        String   @id @default(uuid())
  formId    String   @map("form_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  form forms @relation(fields: [formId], references: [id], onDelete: Cascade)
  user users @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([formId, userId])
  @@index([formId])
  @@index([userId])
  @@map("form_users")
}

model form_departments {
  id           String   @id @default(uuid())
  formId       String   @map("form_id")
  departmentId String   @map("department_id")
  createdAt    DateTime @default(now()) @map("created_at")

  form        forms       @relation(fields: [formId], references: [id], onDelete: Cascade)
  departments departments @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([formId, departmentId])
  @@index([formId])
  @@index([departmentId])
  @@map("form_departments")
}

model form_families {
  id        String   @id @default(uuid())
  formId    String   @map("form_id")
  familyId  String   @map("family_id")
  createdAt DateTime @default(now()) @map("created_at")

  form     forms    @relation(fields: [formId], references: [id], onDelete: Cascade)
  families families @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@unique([formId, familyId])
  @@index([formId])
  @@index([familyId])
  @@map("form_families")
}

model form_downloads {
  id        String   @id @default(uuid())
  formId    String   @map("form_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  form forms @relation(fields: [formId], references: [id], onDelete: Cascade)
  user users @relation(fields: [userId], references: [id])

  @@index([formId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@map("form_downloads")
}

model form_attachments {
  id           String   @id @default(uuid())
  formId       String   @map("form_id")
  filename     String
  originalName String
  mimeType     String   @map("mime_type") @db.VarChar(100)
  size         Int
  path         String
  uploadedById String   @map("uploaded_by_id")
  createdAt    DateTime @default(now()) @map("created_at")

  form       forms @relation(fields: [formId], references: [id], onDelete: Cascade)
  uploadedBy users @relation("FormAttachmentUploader", fields: [uploadedById], references: [id])

  @@index([formId])
  @@map("form_attachments")
}

// ============================================
// WEB PUSH SUBSCRIPTIONS
// ============================================
// Almacena las suscripciones push de cada dispositivo/navegador.
// Un usuario puede tener múltiples suscripciones (laptop + móvil + tablet).
// El endpoint es único por dispositivo — si se re-suscribe, se reemplaza.

model push_subscriptions {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  endpoint  String   @unique // URL única del push service (FCM, Mozilla, Apple)
  p256dh    String   // Clave pública del cliente para cifrado
  auth      String   // Token de autenticación del cliente
  userAgent String?  @map("user_agent") @db.VarChar(500) // Identificar el dispositivo
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user users @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

// ============================================
// CREDENTIALS / VAULT
// ============================================

enum CredentialVaultKind {
  AREA
  PERSONAL
}

enum CredentialShareCapability {
  VIEW
  USE
  EDIT
  ADMIN
}

model credential_vaults {
  id          String              @id @default(uuid())
  familyId    String?             @map("family_id")
  name        String
  description String?
  ownerUserId String?             @map("owner_user_id")
  kind        CredentialVaultKind @default(AREA)
  isActive    Boolean             @default(true) @map("is_active")
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  family  families?            @relation(fields: [familyId], references: [id], onDelete: SetNull)
  owner   users?               @relation("CredentialVaultOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  entries credential_entries[]

  @@index([familyId, isActive])
  @@index([ownerUserId])
  @@map("credential_vaults")
}

model credential_entries {
  id              String    @id @default(uuid())
  vaultId         String    @map("vault_id")
  title           String
  username        String?
  secretEncrypted String    @map("secret_encrypted")
  url             String?
  notes           String?
  entryType       String    @default("GENERIC") @map("entry_type")
  equipmentId     String?   @map("equipment_id")
  licenseId       String?   @map("license_id")
  createdById     String    @map("created_by_id")
  updatedById     String?   @map("updated_by_id")
  lastRevealedAt  DateTime? @map("last_revealed_at")
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  vault     credential_vaults  @relation(fields: [vaultId], references: [id], onDelete: Cascade)
  equipment equipment?         @relation(fields: [equipmentId], references: [id], onDelete: SetNull)
  license   software_licenses? @relation(fields: [licenseId], references: [id], onDelete: SetNull)
  createdBy users              @relation("CredentialEntryCreator", fields: [createdById], references: [id])
  updatedBy users?             @relation("CredentialEntryUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  shares    credential_shares[]

  @@index([vaultId, isActive])
  @@index([equipmentId])
  @@index([licenseId])
  @@map("credential_entries")
}

model credential_shares {
  id         String                    @id @default(uuid())
  entryId    String                    @map("entry_id")
  userId     String?                   @map("user_id")
  familyId   String?                   @map("family_id")
  capability CredentialShareCapability @default(VIEW)
  createdAt  DateTime                  @default(now()) @map("created_at")

  entry  credential_entries @relation(fields: [entryId], references: [id], onDelete: Cascade)
  user   users?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  family families?          @relation(fields: [familyId], references: [id], onDelete: SetNull)

  @@index([entryId])
  @@map("credential_shares")
}
