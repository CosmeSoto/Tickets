FROM node:20-alpine

WORKDIR /app

# Dependencias del sistema requeridas por Prisma y bcrypt en Alpine
RUN apk add --no-cache libc6-compat curl openssl openssl-dev postgresql17-client

# Instalar dependencias de Node ANTES de montar el volumen fuente
# Así el volumen no sobreescribe node_modules del contenedor
COPY package.json package-lock.json ./
RUN npm ci --prefer-offline

# Generar cliente Prisma para la arquitectura Linux del contenedor
COPY prisma ./prisma/
RUN npx prisma generate

# Entrypoint de desarrollo: espera recovery, db push, seed solo si vacío, next dev
COPY docker/entrypoint-dev.sh ./docker/entrypoint-dev.sh
RUN chmod +x ./docker/entrypoint-dev.sh

EXPOSE 3000

CMD ["sh", "docker/entrypoint-dev.sh"]
