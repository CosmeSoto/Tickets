# =============================================
# VARIABLES DE ENTORNO — Sistema de Gestión
# =============================================
# Copia este archivo como:
#   .env.local       → para desarrollo (npm run dev)
#   .env.production  → para producción (docker compose)
#
# Solo las variables marcadas con [REQUERIDA] son obligatorias.
# El resto tiene valores por defecto en el código.
# =============================================

# ── Base de datos [REQUERIDA] ──────────────────
# Desarrollo: postgresql://tickets_user:tickets_password_2024@localhost:5432/tickets_db
# Producción: se construye automáticamente en docker-compose.prod.yml
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/tickets_db"

# ── Redis (opcional — funciona sin él) ─────────
REDIS_URL="redis://localhost:6379"

# ── NextAuth [REQUERIDA] ───────────────────────
# Desarrollo: http://localhost:3000
# Producción: https://gestion.local (o tu dominio)
NEXTAUTH_URL="http://localhost:3000"
# Generar con: openssl rand -base64 32
NEXTAUTH_SECRET="CAMBIAR-generar-con-openssl-rand-base64-32"

# ── Cifrado [REQUERIDA] ───────────────────────
# Para credenciales OAuth almacenadas. Generar con: openssl rand -base64 32
ENCRYPTION_KEY="CAMBIAR-generar-con-openssl-rand-base64-32"
# Para backups cifrados. Generar con: openssl rand -hex 32
BACKUP_ENCRYPTION_KEY="CAMBIAR-generar-con-openssl-rand-hex-32"
# Directorio donde se almacenan exportaciones portátiles (.dump)
BACKUP_DIR="./backups"

# ── pgBackRest (Docker) ────────────────────────
# Secreto compartido entre app y backup-worker
BACKUP_WORKER_SECRET="CAMBIAR-generar-con-openssl-rand-hex-32"
# URL interna del worker (solo en Docker)
BACKUP_WORKER_URL="http://backup-worker:8080"
PGBACKREST_STANZA=main
# Habilitar restauración pgBackRest desde UI (Config → toggle, no requiere editar env)
BACKUP_ALLOW_RESTORE=false

# GID del grupo docker en el host (restauración pgBackRest detiene contenedores vía socket)
# start-production.sh lo detecta automáticamente; en Debian: getent group docker | cut -d: -f3
DOCKER_GID=999

# ── Producción: contraseña de BD [REQUERIDA en docker-compose.prod.yml]
DB_PASSWORD=tickets_password_2024

# ── Cron (protege endpoints /api/cron/*) ───────
CRON_SECRET="CAMBIAR-generar-con-openssl-rand-hex-16"

# ── Logs ───────────────────────────────────────
LOG_LEVEL="ERROR"

# ── Zona horaria ───────────────────────────────
TZ="America/Guayaquil"

# ── Email (opcional) ───────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_ADDRESS=

# ── OAuth (opcional) ───────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=common

# ── Web Push (notificaciones con navegador cerrado) ────
# Generar con: npx web-push generate-vapid-keys --json
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@tudominio.com"

# ── Telegram Bot (notificaciones operativas al staff) ──
# 1. Habla con @BotFather y crea un bot: /newbot
# 2. Copia el token aquí
TELEGRAM_BOT_TOKEN=""
# 3. Username del bot (sin @). Ej: mi_sistema_bot
TELEGRAM_BOT_USERNAME=""
# 4. Secreto para verificar updates de Telegram. Generar: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=""
# 5. Tras arrancar en producción registra el webhook: POST /api/telegram/register-webhook
